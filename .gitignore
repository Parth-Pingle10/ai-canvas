# --- Frontend (Node/Vite) ---
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local

# --- Backend (Python) ---
backend/.venv
backend/venv
backend/__pycache__
backend/**/__pycache__
backend/*.egg-info
backend/.pytest_cache

# --- Trace output (local run data, not source) ---
backend/traces/*.jsonl

# --- Environment files with real secrets ---
.env
*.env
frontend/.env
backend/.env
test.py

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# --- Logs ---
*.log
npm-debug.log*
