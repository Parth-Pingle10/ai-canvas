# Copy this file to .env and adjust as needed. Never commit the real .env.
# Vite only exposes variables prefixed with VITE_ to client code — see
# https://vite.dev/guide/env-and-mode for details.

# --- Backend location ---
VITE_API_BASE_URL=http://localhost:8000

# --- AI trigger behavior (mirrors backend/.env.example's AI_IDLE_DELAY_MS;
#     keep the two in sync manually — the frontend debounces locally so the
#     canvas doesn't wait on a round trip to know when to fire) ---
VITE_AI_IDLE_DELAY_MS=700

# --- Region-of-interest defaults (mirrors backend/.env.example's ROI_*) ---
VITE_AI_ROI_MARGIN=100
VITE_AI_ROI_RESOLUTION=1024
VITE_AI_ROI_FORMAT=png
