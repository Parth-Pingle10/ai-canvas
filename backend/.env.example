# Copy this file to .env and adjust as needed. Never commit the real .env.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_FALLBACK_MODEL=qwen3-vl:4b

# --- Request behavior ---
AI_IDLE_DELAY_MS=700
AI_REQUEST_TIMEOUT_MS=30000

# --- Region-of-interest defaults (kept in sync with the frontend's own
#     VITE_AI_* defaults in frontend/.env.example; the backend only uses
#     these for validation, extraction itself happens client-side) ---
ROI_MARGIN=100
ROI_FORMAT=webp
ROI_RESOLUTION=1024

# --- KPI: Budget Compliance threshold ---
LATENCY_BUDGET_MS=8000

# --- Cost rate table. Zero = accurate for local Ollama. Fill in a specific,
#     documented hosted-provider price only if you want a notional
#     cost-comparison figure — see backend/README.md "Cost accounting". ---
COST_MODEL_NAME=local-ollama
COST_INPUT_PER_MILLION=0
COST_OUTPUT_PER_MILLION=0

# --- Safety limits ---
MAX_REQUEST_BYTES=8388608
MAX_IMAGE_DIMENSION=4096
MIN_IMAGE_DIMENSION=8

# --- CORS: origins allowed to call this API (comma-separated) ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Trace output directory ---
TRACES_DIR=traces
